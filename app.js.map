
import { PuzzleView } from '@magic-spells/puzzle';
import { seedReady } from '../app.js';
import Button from '../components/Button.pzl';
import TrackRow from '../components/TrackRow.pzl';
import AlbumCard from '../components/AlbumCard.pzl';
import Icon from '../components/Icon.pzl';

export default class ArtistView extends PuzzleView {
  // Async data() gated on seedReady (SPEC §16, D39): the <puzzle-skeleton> above
  // shows while this awaits, then the real content patches in. After seedReady an
  // absent artist is a genuine not-found, not a mid-load blank.
  async data(params, props) {
    await seedReady;
    const store = this.ctx.store;
    const artist = store.findOne('artist', params.id);
    const albums = store
      .findMany('album', { filter: (al) => al.artistId === params.id })
      .sort((a, b) => (b.year || 0) - (a.year || 0));
    const popular = store
      .findMany('track', { filter: (t) => t.artistId === params.id })
      .sort((a, b) => b.plays - a.plays)
      .slice(0, 5);
    const player = store.findMany('player')[0] || null;

    return {
      artist,
      albums,
      popular,
      // Header glow color: accent.from + '4d' (8-digit hex ≈ 30% alpha).
      headerGlow: artist && artist.accent ? (artist.accent.from || '#3a3a44') + '4d' : '',
      currentTrackId: player ? player.currentTrackId : '',
      isPlaying: player ? player.isPlaying : false
    };
  }

  events = {
    playArtist: () => {
      const player = this._player();
      const ids = this._orderedIds();
      if (player && ids.length) player.play(ids[0], ids);
    },
    // Navigate to the overlay child route — the router morphs the Info button
    // into the dialog shell (they share a data-puzzle-morph value, D55).
    openInfo: () => {
      this.ctx.router.push('/artist/' + this.getData().artist.id + '/info');
    },
    playTrack: (track) => {
      const player = this._player();
      if (player) player.play(track.id, this._orderedIds());
    },
    likeTrack: (track) => track.toggleLike()
  };

  _player() {
    return this.ctx.store.findMany('player')[0] || null;
  }

  // The artist's whole catalogue as an ordered id list (newest album first, then
  // track order) — the queue when you press play anywhere on this page.
  _orderedIds() {
    const store = this.ctx.store;
    const id = this.params.id;
    const albums = store
      .findMany('album', { filter: (al) => al.artistId === id })
      .sort((a, b) => (b.year || 0) - (a.year || 0));
    const ids = [];
    albums.forEach((al) => {
      store
        .findMany('track', { filter: (t) => t.albumId === al.id })
        .sort((a, b) => a.trackNo - b.trackNo)
        .forEach((t) => ids.push(t.id));
    });
    return ids;
  }

  animations = {
    // in is OPACITY-ONLY (no translateY): the art-morph engine measures the header
    // avatar's rect once at flight start, so a transform-based entrance would slide
    // the real avatar away from where the blob lands (same rule as Album.pzl).
    in:  { from: { opacity: 0 }, to: { opacity: 1 }, duration: 260, easing: 'ease-out' },
    out: { from: { opacity: 1, transform: 'translateY(0)' },    to: { opacity: 0, transform: 'translateY(-8px)' }, duration: 160, easing: 'ease-in' }
  };
}

import { ViewNode, SLOT_TAG } from '@magic-spells/puzzle';

ArtistView.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    ...(__d.artist
      ? [
          new ViewNode('div', {
            class: 'pointer-events-none absolute inset-x-0 top-0 -z-10 h-80',
            style: `background:linear-gradient(to bottom, ${__d.headerGlow}, transparent)`,
          }, []),
          new ViewNode('header', { class: 'mb-9' }, [
            new ViewNode('div', { class: 'flex items-end gap-5' }, [
              new ViewNode('div', {
                'data-art-morph': `artist-${__d.artist.id}`,
                class: 'w-28 h-28 sm:w-40 sm:h-40 rounded-full shrink-0 flex items-center justify-center ring-1 ring-white/10 shadow-xl shadow-black/40',
                style: `background:${__d.artist.artwork}`,
              }, [
                new ViewNode('span', { class: 'font-display text-4xl font-bold text-white/90 drop-shadow' }, [
                  new ViewNode('text', { value: String(__d.artist.initials) }),
                ]),
              ]),
              new ViewNode('div', { class: 'min-w-0 pb-1' }, [
                new ViewNode('div', {
                  class: 'text-[11px] font-semibold uppercase tracking-[0.18em] text-muted mb-1',
                }, [
                  new ViewNode('text', { value: String(__d.artist.genre) }),
                ]),
                new ViewNode('h1', { class: 'font-display text-4xl sm:text-5xl font-bold text-fg leading-none' }, [
                  new ViewNode('text', { value: String(__d.artist.name) }),
                ]),
                new ViewNode('p', { class: 'text-muted mt-3' }, [
                  new ViewNode('text', { value: String((__f.compact || __f.__missing('compact'))(__d.artist.monthlyListeners)) + ' monthly listeners' }),
                ]),
              ]),
            ]),
            new ViewNode('div', { class: 'flex items-center gap-3 mt-6' }, [
              new ViewNode(Button, { press: (event) => this.events.playArtist(event) }, [
                new ViewNode(Icon, {
                  name: 'play',
                  size: 16,
                }, []),
                new ViewNode('text', { value: ' Play' }),
              ]),
              new ViewNode('button', {
                type: 'button',
                class: 'inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold cursor-pointer transition-all bg-transparent text-fg border border-hairline hover:border-fg/40 hover:scale-[1.03] active:scale-95',
                'data-puzzle-morph': `artist-info-${__d.artist.id}`,
                'aria-haspopup': 'dialog',
                '@click': (event) => this.events.openInfo(event),
              }, [
                new ViewNode(Icon, {
                  name: 'info',
                  size: 16,
                }, []),
                new ViewNode('text', { value: ' Info' }),
              ]),
            ]),
            new ViewNode('p', { class: 'text-muted max-w-2xl mt-6 leading-relaxed' }, [
              new ViewNode('text', { value: String(__d.artist.bio) }),
            ]),
          ]),
          new ViewNode('section', { class: 'mb-10' }, [
            new ViewNode('h2', { class: 'font-display text-xl font-bold text-fg mb-3' }, [
              new ViewNode('text', { value: 'Popular' }),
            ]),
            new ViewNode('div', { class: 'flex flex-col' },
              __d.popular.map((track, i) =>
                new ViewNode(TrackRow, {
                  key: track.id,
                  track: track,
                  position: i + 1,
                  current: track.id === __d.currentTrackId,
                  playing: track.id === __d.currentTrackId && __d.isPlaying,
                  play: (event) => this.events.playTrack(track),
                  like: (event) => this.events.likeTrack(track),
                }, [])
              )
            ),
          ]),
          new ViewNode('section', {}, [
            new ViewNode('h2', { class: 'font-display text-xl font-bold text-fg mb-4' }, [
              new ViewNode('text', { value: 'Albums' }),
            ]),
            new ViewNode('div', { class: 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6' },
              __d.albums.map((album, i) =>
                new ViewNode(AlbumCard, {
                  key: album.id,
                  album: album,
                  artistName: __d.artist.name,
                  index: i,
                }, [])
              )
            ),
          ]),
        ]
      : [
          new ViewNode('div', { class: 'py-24 text-center' }, [
            new ViewNode('h1', { class: 'text-xl text-fg mb-2' }, [
              new ViewNode('text', { value: 'Artist not found' }),
            ]),
            new ViewNode('p', { class: 'text-muted' }, [
              new ViewNode('text', { value: 'No artist with that id. ' }),
              new ViewNode('a', {
                href: '#/',
                class: 'text-accent',
              }, [
                new ViewNode('text', { value: 'Back to your library' }),
              ]),
              new ViewNode('text', { value: '.' }),
            ]),
          ]),
        ]),
    new ViewNode(SLOT_TAG),
  ]);
};

ArtistView.prototype.renderSkeleton = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    new ViewNode('div', { class: 'animate-pulse' }, [
      new ViewNode('header', { class: 'mb-9' }, [
        new ViewNode('div', { class: 'flex items-end gap-5' }, [
          new ViewNode('div', { class: 'w-28 h-28 sm:w-40 sm:h-40 rounded-full shrink-0 bg-surface-2' }, []),
          new ViewNode('div', { class: 'min-w-0 pb-1 flex-1' }, [
            new ViewNode('div', { class: 'h-3 w-20 rounded bg-surface-2 mb-3' }, []),
            new ViewNode('div', { class: 'h-10 w-64 max-w-full rounded-lg bg-elevated mb-3' }, []),
            new ViewNode('div', { class: 'h-3 w-40 rounded bg-surface-2' }, []),
          ]),
        ]),
      ]),
      new ViewNode('div', { class: 'h-5 w-24 rounded bg-surface-2 mb-4' }, []),
      new ViewNode('div', { class: 'flex flex-col gap-2' },
        Array.from({ length: 5 - 1 + 1 }, (_, __i) =>
          new ViewNode('div', {
            key: __i,
            class: 'h-12 rounded-lg bg-surface-2',
          }, [])
        )
      ),
    ]),
  ]);
};
