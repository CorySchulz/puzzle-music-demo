
import { PuzzleView } from '@magic-spells/puzzle';
import { seedReady } from '../app.js';

// Routed overlay for an artist's details — the leaf child of the artist route
// (path 'info'), rendered inside ArtistView's <Slot/> so the artist page (and the
// Info button that opened it) stays mounted beneath it. There is ZERO morph code
// in this view: the <dialog> shell shares its data-puzzle-morph value with the
// button, and the router pairs them on the way in and out (D55) — including the
// browser back button. Escape / backdrop / the ✕ button just navigate; the
// reverse morph is awaited by the router before this view is destroyed.
export default class ArtistInfoDialog extends PuzzleView {
  created() {
    this._onKey = (event) => {
      if (event.key !== 'Escape' || event.defaultPrevented) return;
      this._close();
    };
  }

  // Awaits seedReady like ArtistView, then looks the artist up the same way
  // (findOne). By the time you're on the artist page and open this, the seed has
  // long resolved; on a deep link it renders plain (no morph) once the store fills.
  async data(params) {
    await seedReady;
    const artist = this.ctx.store.findOne('artist', params.id);
    return {
      artistId: params.id,
      artist,
    };
  }

  mounted() {
    document.addEventListener('keydown', this._onKey);
  }

  // The morph flies the dialog back while this view is still mounted; fade the
  // backdrop out alongside it. viewWillHide fires as the out phase starts —
  // exactly when the reverse flight begins.
  viewWillHide() {
    const backdrop = this.element && this.element.querySelector('.artist-info-backdrop');
    if (backdrop) backdrop.classList.add('is-leaving');
  }

  destroyed() {
    document.removeEventListener('keydown', this._onKey);
  }

  // Navigate back to the parent index (predictable even on a deep link, where
  // there's no history entry to pop) — the router pairs the reverse morph.
  _close() {
    this.ctx.router.push('/artist/' + this.getData().artistId);
  }

  events = {
    close: () => this._close(),
  };
}

import { ViewNode } from '@magic-spells/puzzle';

ArtistInfoDialog.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', { class: 'contents' }, [
    new ViewNode('div', { class: 'fixed inset-0 z-40 flex items-center justify-center p-4 sm:p-8' }, [
      new ViewNode('button', {
        type: 'button',
        class: 'artist-info-backdrop absolute inset-0',
        'aria-label': 'Close',
        '@click': (event) => this.events.close(event),
      }, []),
      new ViewNode('dialog', {
        class: 'artist-info-dialog relative flex w-full max-w-lg flex-col',
        open: 'open',
        'data-puzzle-morph': `artist-info-${__d.artistId}`,
      }, [
        ...(__d.artist
          ? [
              new ViewNode('header', { class: 'flex items-start justify-between gap-4 px-7 pt-7' }, [
                new ViewNode('div', { class: 'flex items-center gap-4 min-w-0' }, [
                  new ViewNode('div', {
                    class: 'w-16 h-16 rounded-full shrink-0 flex items-center justify-center ring-1 ring-white/10 shadow-lg shadow-black/40',
                    style: `background:${__d.artist.artwork}`,
                  }, [
                    new ViewNode('span', { class: 'font-display text-xl font-bold text-white/90 drop-shadow' }, [
                      new ViewNode('text', { value: String(__d.artist.initials) }),
                    ]),
                  ]),
                  new ViewNode('div', { class: 'min-w-0' }, [
                    new ViewNode('p', {
                      class: 'text-[11px] font-semibold uppercase tracking-[0.18em] text-muted mb-1',
                    }, [
                      new ViewNode('text', { value: String(__d.artist.genre) }),
                    ]),
                    new ViewNode('h2', { class: 'font-display text-3xl font-bold text-fg leading-none truncate' }, [
                      new ViewNode('text', { value: String(__d.artist.name) }),
                    ]),
                  ]),
                ]),
                new ViewNode('button', {
                  type: 'button',
                  class: 'artist-info-close',
                  'aria-label': 'Close',
                  '@click': (event) => this.events.close(event),
                }, [
                  new ViewNode('text', { value: '✕' }),
                ]),
              ]),
              new ViewNode('div', { class: 'flex items-center gap-8 px-7 pt-6' }, [
                new ViewNode('div', {}, [
                  new ViewNode('div', { class: 'font-display text-2xl font-bold text-fg tabular-nums' }, [
                    new ViewNode('text', { value: String((__f.compact || __f.__missing('compact'))(__d.artist.followers)) }),
                  ]),
                  new ViewNode('div', {
                    class: 'text-[11px] font-semibold uppercase tracking-[0.14em] text-faint mt-0.5',
                  }, [
                    new ViewNode('text', { value: 'Followers' }),
                  ]),
                ]),
                new ViewNode('div', {}, [
                  new ViewNode('div', { class: 'font-display text-2xl font-bold text-fg tabular-nums' }, [
                    new ViewNode('text', { value: String((__f.compact || __f.__missing('compact'))(__d.artist.monthlyListeners)) }),
                  ]),
                  new ViewNode('div', {
                    class: 'text-[11px] font-semibold uppercase tracking-[0.14em] text-faint mt-0.5',
                  }, [
                    new ViewNode('text', { value: 'Monthly listeners' }),
                  ]),
                ]),
              ]),
              new ViewNode('div', { class: 'px-7 py-7' }, [
                new ViewNode('p', { class: 'text-sm leading-6 text-muted' }, [
                  new ViewNode('text', { value: String(__d.artist.bio) }),
                ]),
              ]),
            ]
          : []),
      ]),
    ]),
  ]);
};
