
import { PuzzleView } from '@magic-spells/puzzle';
import { seedReady } from '../app.js';
import ArtistCard from '../components/ArtistCard.pzl';
import AlbumCard from '../components/AlbumCard.pzl';
import Icon from '../components/Icon.pzl';

export default class LibraryView extends PuzzleView {
  // Async data() gated on seedReady (SPEC §16, D39): the <puzzle-skeleton> above
  // is the first paint while the store loads, then the real Home patches in.
  async data(params, props) {
    await seedReady;
    const store = this.ctx.store;
    const artists = store.findMany('artist');
    const albums = store.findMany('album');
    const player = store.findMany('player')[0] || null;

    // Join album → artist name here (in data(), not the template).
    const artistById = {};
    artists.forEach((a) => { artistById[a.id] = a; });
    const rowFor = (album) => ({
      album,
      artistName: (artistById[album.artistId] || {}).name || ''
    });

    const albumRows = albums.map(rowFor);

    // Recently played: resolve the player's recentAlbumIds (newest first) to real
    // album records, dropping any that no longer exist, and keep the order.
    const recentIds = player ? player.recentAlbumIds : [];
    const recentRows = recentIds
      .map((id) => store.findOne('album', id))
      .filter(Boolean)
      .map(rowFor);

    return {
      artists,
      albums,
      albumRows,
      recentRows,
      // Playlists for the Quick picks tiles, sorted by their `order` field.
      playlists: store.findMany('playlist').slice().sort((a, b) => a.order - b.order),
      // Current hour (0-23) drives the greeting {:else if} chain in the template.
      hour: new Date().getHours()
    };
  }

  animations = {
    in:  { from: { opacity: 0, transform: 'translateY(10px)' }, to: { opacity: 1, transform: 'translateY(0)' },  duration: 260, easing: 'ease-out' },
    out: { from: { opacity: 1, transform: 'translateY(0)' },    to: { opacity: 0, transform: 'translateY(-8px)' }, duration: 160, easing: 'ease-in' }
  };
}

import { ViewNode } from '@magic-spells/puzzle';

LibraryView.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    new ViewNode('header', { class: 'mb-8' }, [
      new ViewNode('h1', { class: 'font-display text-3xl font-bold text-fg' }, [
        ...(__d.hour < 5
          ? [
              new ViewNode('text', { value: 'Night owl session' }),
            ]
          : [
              ...(__d.hour < 12
                ? [
                    new ViewNode('text', { value: 'Good morning' }),
                  ]
                : [
                    ...(__d.hour < 18
                      ? [
                          new ViewNode('text', { value: 'Good afternoon' }),
                        ]
                      : [
                          new ViewNode('text', { value: 'Good evening' }),
                        ]),
                  ]),
            ]),
      ]),
      new ViewNode('p', { class: 'text-muted mt-1' }, [
        new ViewNode('text', { value: String(__d.artists.length) + ' ' + String((__f.plural || __f.__missing('plural'))(__d.artists.length, 'artist', 'artists')) + ' · ' + String(__d.albums.length) + ' albums in your library' }),
      ]),
    ]),
    new ViewNode('section', { class: 'mb-10' }, [
      new ViewNode('div', { class: 'grid grid-cols-2 sm:grid-cols-3 gap-3' }, [
        new ViewNode('a', {
          href: '#/liked',
          class: 'group flex items-center gap-3 h-14 rounded-lg bg-surface hover:bg-surface-2 hover:no-underline overflow-hidden transition-colors',
        }, [
          new ViewNode('span', {
            class: 'w-14 h-14 shrink-0 flex items-center justify-center text-white/90',
            style: 'background:linear-gradient(135deg,#7c5cff,#c86dd7)',
          }, [
            new ViewNode(Icon, {
              name: 'heart-filled',
              size: 20,
            }, []),
          ]),
          new ViewNode('span', { class: 'font-semibold text-fg truncate pr-3' }, [
            new ViewNode('text', { value: 'Liked Songs' }),
          ]),
        ]),
        ...__d.playlists.map((p, i) =>
          new ViewNode('a', {
            key: p.id,
            href: `#/playlist/${p.id}`,
            class: 'group flex items-center gap-3 h-14 rounded-lg bg-surface hover:bg-surface-2 hover:no-underline overflow-hidden transition-colors',
          }, [
            new ViewNode('span', {
              class: 'w-14 h-14 shrink-0',
              style: `background:${p.artwork}`,
            }, []),
            new ViewNode('span', { class: 'font-semibold text-fg truncate pr-3' }, [
              new ViewNode('text', { value: String(p.name) }),
            ]),
          ])
        ),
      ]),
    ]),
    ...(__d.recentRows.length > 0
      ? [
          new ViewNode('section', { class: 'mb-10' }, [
            new ViewNode('h2', { class: 'font-display text-xl font-bold text-fg mb-4' }, [
              new ViewNode('text', { value: 'Recently played' }),
            ]),
            new ViewNode('div', { class: 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6' },
              __d.recentRows.map((row, i) =>
                new ViewNode(AlbumCard, {
                  key: row.id,
                  album: row.album,
                  artistName: row.artistName,
                  index: i,
                }, [])
              )
            ),
          ]),
        ]
      : []),
    new ViewNode('section', { class: 'mb-10' }, [
      new ViewNode('h2', { class: 'font-display text-xl font-bold text-fg mb-4' }, [
        new ViewNode('text', { value: 'Artists' }),
      ]),
      new ViewNode('div', { class: 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6' },
        __d.artists.map((artist, i) =>
          new ViewNode(ArtistCard, {
            key: artist.id,
            artist: artist,
            index: i,
          }, [])
        )
      ),
    ]),
    new ViewNode('section', {}, [
      new ViewNode('h2', { class: 'font-display text-xl font-bold text-fg mb-4' }, [
        new ViewNode('text', { value: 'Albums' }),
      ]),
      new ViewNode('div', { class: 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6' },
        __d.albumRows.map((row, i) =>
          new ViewNode(AlbumCard, {
            key: row.id,
            album: row.album,
            artistName: row.artistName,
            index: i,
          }, [])
        )
      ),
    ]),
  ]);
};

LibraryView.prototype.renderSkeleton = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    new ViewNode('div', { class: 'animate-pulse' }, [
      new ViewNode('header', { class: 'mb-8' }, [
        new ViewNode('div', { class: 'h-9 w-56 max-w-full rounded-lg bg-elevated mb-2' }, []),
        new ViewNode('div', { class: 'h-3 w-40 rounded bg-surface-2' }, []),
      ]),
      new ViewNode('section', { class: 'mb-10' }, [
        new ViewNode('div', { class: 'grid grid-cols-2 sm:grid-cols-3 gap-3' },
          Array.from({ length: 4 - 1 + 1 }, (_, __i) =>
            new ViewNode('div', {
              key: __i,
              class: 'h-14 rounded-lg bg-surface-2',
            }, [])
          )
        ),
      ]),
      new ViewNode('section', { class: 'mb-10' }, [
        new ViewNode('div', { class: 'h-5 w-24 rounded bg-surface-2 mb-4' }, []),
        new ViewNode('div', { class: 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6' },
          Array.from({ length: 4 - 1 + 1 }, (_, __i) =>
            new ViewNode('div', {
              key: __i,
              class: 'flex flex-col items-center',
            }, [
              new ViewNode('div', { class: 'aspect-square w-full rounded-full bg-surface-2 mb-3' }, []),
              new ViewNode('div', { class: 'h-3 w-20 rounded bg-surface-2' }, []),
            ])
          )
        ),
      ]),
      new ViewNode('section', {}, [
        new ViewNode('div', { class: 'h-5 w-24 rounded bg-surface-2 mb-4' }, []),
        new ViewNode('div', { class: 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6' },
          Array.from({ length: 4 - 1 + 1 }, (_, __i) =>
            new ViewNode('div', { key: __i }, [
              new ViewNode('div', { class: 'aspect-square w-full rounded-xl bg-surface-2 mb-3' }, []),
              new ViewNode('div', { class: 'h-3 w-24 rounded bg-surface-2' }, []),
            ])
          )
        ),
      ]),
    ]),
  ]);
};
