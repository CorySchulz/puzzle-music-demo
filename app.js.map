
import { PuzzleView } from '@magic-spells/puzzle';

export default class NotFoundView extends PuzzleView {
  data(params, props) {
    return {};
  }

  animations = {
    in:  { from: { opacity: 0, transform: 'translateY(10px)' }, to: { opacity: 1, transform: 'translateY(0)' },  duration: 240, easing: 'ease-out' },
    out: { from: { opacity: 1, transform: 'translateY(0)' },    to: { opacity: 0, transform: 'translateY(-8px)' }, duration: 160, easing: 'ease-in' }
  };
}

import { ViewNode } from '@magic-spells/puzzle';

NotFoundView.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    new ViewNode('div', { class: 'py-24 text-center' }, [
      new ViewNode('div', { class: 'font-display text-6xl font-bold text-fg mb-2' }, [
        new ViewNode('text', { value: '404' }),
      ]),
      new ViewNode('p', { class: 'text-muted mb-6' }, [
        new ViewNode('text', { value: 'We couldn\'t find that page.' }),
      ]),
      new ViewNode('a', {
        href: '#/',
        class: 'inline-block px-5 py-2.5 rounded-full bg-accent text-accent-ink text-sm font-semibold hover:bg-accent-2 hover:no-underline transition-colors',
      }, [
        new ViewNode('text', { value: 'Back to your library' }),
      ]),
    ]),
  ]);
};
