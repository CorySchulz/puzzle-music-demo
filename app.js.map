
import { PuzzleView } from '@magic-spells/puzzle';
import { seedReady } from '../app.js';
import Button from '../components/Button.pzl';
import TrackRow from '../components/TrackRow.pzl';
import Icon from '../components/Icon.pzl';

export default class PlaylistView extends PuzzleView {
  // Async data() gated on seedReady (SPEC §16, D39): the compact <puzzle-skeleton>
  // shows while this awaits. Playlists are created at the tail of the seed, so
  // after seedReady a missing playlist is a genuine not-found.
  async data(params, props) {
    await seedReady;
    const store = this.ctx.store;
    const playlist = store.findOne('playlist', params.id);
    // Join the ordered id list to real track records, dropping any that no
    // longer exist. This keeps `trackIds` (the source of truth) authoritative.
    const tracks = playlist
      ? playlist.trackIds.map((id) => store.findOne('track', id)).filter(Boolean)
      : [];
    const totalSec = tracks.reduce((sum, t) => sum + (t.durationSec || 0), 0);
    const player = store.findMany('player')[0] || null;

    return {
      playlist,
      tracks,
      // Header glow color: accent.from + '4d' (8-digit hex ≈ 30% alpha).
      headerGlow: playlist && playlist.accent ? (playlist.accent.from || '#7c5cff') + '4d' : '',
      trackIds: tracks.map((t) => t.id),
      totalMin: Math.max(1, Math.round(totalSec / 60)),
      // Local UI flag for the inline rename (setData does not re-run data(), so
      // we read it back through getData — same pattern as the layout's queueOpen).
      renaming: this.getData().renaming || false,
      currentTrackId: player ? player.currentTrackId : '',
      isPlaying: player ? player.isPlaying : false
    };
  }

  events = {
    startRename: () => {
      this.setData('renaming', true);
      this._focusRename = true; // afterUpdate grabs focus once
      this.refresh();
    },
    saveRename: (event) => {
      const p = this.getData().playlist;
      if (p) p.rename(event.target.value); // rename() no-ops on empty
      this.setData('renaming', false);
      this.refresh();
    },
    cancelRename: () => {
      this.setData('renaming', false);
      this.refresh();
    },
    playPlaylist: () => {
      const player = this._player();
      const ids = this.getData().trackIds;
      if (player && ids.length) player.play(ids[0], ids);
    },
    playTrack: (track) => {
      const player = this._player();
      if (player) player.play(track.id, this.getData().trackIds);
    },
    likeTrack: (track) => track.toggleLike(),
    removeTrack: (track) => {
      const p = this.getData().playlist;
      // update() notifies subscribers → this view's data() re-runs and the row
      // drops out; no manual refresh needed.
      if (p) p.removeTrack(track.id);
    },
    deletePlaylist: () => {
      const p = this.getData().playlist;
      if (p) p.destroy();
      this.ctx.router.push('/'); // path-shaped push (hash mode encodes it, D34)
    }
  };

  // Focus the rename input once, right after the render that turned `renaming`
  // on (guarded so ongoing re-renders don't keep stealing/selecting).
  afterUpdate() {
    if (this._focusRename && this.getData().renaming) {
      const input = this.element.querySelector('input[type="text"]');
      if (input) {
        input.focus();
        input.select();
      }
      this._focusRename = false;
    }
  }

  _player() {
    return this.ctx.store.findMany('player')[0] || null;
  }

  animations = {
    in:  { from: { opacity: 0, transform: 'translateY(10px)' }, to: { opacity: 1, transform: 'translateY(0)' },  duration: 260, easing: 'ease-out' },
    out: { from: { opacity: 1, transform: 'translateY(0)' },    to: { opacity: 0, transform: 'translateY(-8px)' }, duration: 160, easing: 'ease-in' }
  };
}

import { ViewNode } from '@magic-spells/puzzle';

PlaylistView.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    ...(__d.playlist
      ? [
          new ViewNode('div', {
            class: 'pointer-events-none absolute inset-x-0 top-0 -z-10 h-80',
            style: `background:linear-gradient(to bottom, ${__d.headerGlow}, transparent)`,
          }, []),
          new ViewNode('header', { class: 'mb-8' }, [
            new ViewNode('div', { class: 'flex flex-col sm:flex-row items-center sm:items-end gap-6' }, [
              new ViewNode('div', {
                class: 'w-44 h-44 sm:w-52 sm:h-52 rounded-2xl shrink-0 ring-1 ring-white/10 shadow-2xl shadow-black/50',
                style: `background:${__d.playlist.artwork}`,
              }, []),
              new ViewNode('div', { class: 'text-center sm:text-left min-w-0 pb-1' }, [
                new ViewNode('div', {
                  class: 'text-[11px] font-semibold uppercase tracking-[0.18em] text-muted mb-2',
                }, [
                  new ViewNode('text', { value: 'Playlist' }),
                ]),
                ...(__d.renaming
                  ? [
                      new ViewNode('input', {
                        type: 'text',
                        class: 'font-display text-3xl sm:text-5xl font-bold text-fg leading-tight bg-transparent border-b-2 border-accent/60 focus:outline-none w-full max-w-xl',
                        value: __d.playlist.name,
                        '@keydown:enter': (event) => this.events.saveRename(event),
                        '@keydown:escape': (event) => this.events.cancelRename(event),
                        'aria-label': 'Playlist name',
                      }, []),
                    ]
                  : [
                      new ViewNode('h1', {
                        class: 'font-display text-3xl sm:text-5xl font-bold text-fg leading-tight cursor-text hover:text-accent transition-colors',
                        title: 'Click to rename',
                        '@click': (event) => this.events.startRename(event),
                      }, [
                        new ViewNode('text', { value: String(__d.playlist.name) }),
                      ]),
                    ]),
                new ViewNode('p', { class: 'text-muted mt-3' }, [
                  new ViewNode('text', { value: String(__d.tracks.length) + ' ' + String((__f.plural || __f.__missing('plural'))(__d.tracks.length, 'song', 'songs')) }),
                  ...(__d.tracks.length > 0
                    ? [
                        new ViewNode('text', { value: ' · ' + String(__d.totalMin) + ' min' }),
                      ]
                    : []),
                ]),
                new ViewNode('div', { class: 'mt-2' }, [
                  new ViewNode('button', {
                    class: 'text-xs text-faint hover:text-fg transition-colors',
                    '@click': (event) => this.events.deletePlaylist(event),
                  }, [
                    new ViewNode('text', { value: 'Delete playlist' }),
                  ]),
                ]),
              ]),
            ]),
            new ViewNode('div', { class: 'flex items-center gap-3 mt-6 justify-center sm:justify-start' }, [
              new ViewNode(Button, { press: (event) => this.events.playPlaylist(event) }, [
                new ViewNode(Icon, {
                  name: 'play',
                  size: 16,
                }, []),
                new ViewNode('text', { value: ' Play' }),
              ]),
            ]),
          ]),
          ...(__d.tracks.length > 0
            ? [
                new ViewNode('section', { class: 'flex flex-col' },
                  __d.tracks.map((track, i) =>
                    new ViewNode(TrackRow, {
                      key: track.id,
                      track: track,
                      position: i + 1,
                      current: track.id === __d.currentTrackId,
                      playing: track.id === __d.currentTrackId && __d.isPlaying,
                      removable: true,
                      play: (event) => this.events.playTrack(track),
                      like: (event) => this.events.likeTrack(track),
                      remove: (event) => this.events.removeTrack(track),
                    }, [])
                  )
                ),
              ]
            : [
                new ViewNode('div', { class: 'py-20 text-center' }, [
                  new ViewNode('p', { class: 'text-muted' }, [
                    new ViewNode('text', { value: 'Nothing here yet — find something you love.' }),
                  ]),
                  new ViewNode('a', {
                    href: '#/search',
                    class: 'text-accent',
                  }, [
                    new ViewNode('text', { value: 'Search your library' }),
                  ]),
                  new ViewNode('text', { value: '.' }),
                ]),
              ]),
        ]
      : [
          new ViewNode('div', { class: 'py-24 text-center' }, [
            new ViewNode('h1', { class: 'text-xl text-fg mb-2' }, [
              new ViewNode('text', { value: 'Playlist not found' }),
            ]),
            new ViewNode('p', { class: 'text-muted' }, [
              new ViewNode('text', { value: 'No playlist with that id. ' }),
              new ViewNode('a', {
                href: '#/',
                class: 'text-accent',
              }, [
                new ViewNode('text', { value: 'Back to your library' }),
              ]),
              new ViewNode('text', { value: '.' }),
            ]),
          ]),
        ]),
  ]);
};

PlaylistView.prototype.renderSkeleton = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    new ViewNode('div', { class: 'animate-pulse' }, [
      new ViewNode('header', { class: 'mb-8' }, [
        new ViewNode('div', { class: 'flex flex-col sm:flex-row items-center sm:items-end gap-6' }, [
          new ViewNode('div', { class: 'w-44 h-44 sm:w-52 sm:h-52 rounded-2xl shrink-0 bg-surface-2' }, []),
          new ViewNode('div', { class: 'min-w-0 pb-1 flex-1' }, [
            new ViewNode('div', { class: 'h-3 w-20 rounded bg-surface-2 mb-3' }, []),
            new ViewNode('div', { class: 'h-10 w-64 max-w-full rounded-lg bg-elevated mb-3' }, []),
            new ViewNode('div', { class: 'h-3 w-32 rounded bg-surface-2' }, []),
          ]),
        ]),
      ]),
      new ViewNode('div', { class: 'flex flex-col gap-2' },
        Array.from({ length: 3 - 1 + 1 }, (_, __i) =>
          new ViewNode('div', {
            key: __i,
            class: 'h-12 rounded-lg bg-surface-2',
          }, [])
        )
      ),
    ]),
  ]);
};
