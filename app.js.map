
import { PuzzleView } from '@magic-spells/puzzle';
import ArtistCard from '../components/ArtistCard.pzl';
import AlbumCard from '../components/AlbumCard.pzl';
import TrackRow from '../components/TrackRow.pzl';

export default class SearchView extends PuzzleView {
  created() {
    this.setData({ query: '' });
  }

  data(params, props) {
    const store = this.ctx.store;
    const query = this.getData().query || '';
    const q = query.trim().toLowerCase();
    const has = q.length > 0;

    let artists = [];
    let albumRows = [];
    let tracks = [];

    if (has) {
      artists = store.findMany('artist', {
        filter: (a) => a.name.toLowerCase().includes(q) || String(a.genre).toLowerCase().includes(q)
      });

      const artistById = {};
      store.findMany('artist').forEach((a) => { artistById[a.id] = a; });

      albumRows = store
        .findMany('album', { filter: (al) => al.title.toLowerCase().includes(q) })
        .map((album) => ({ album, artistName: (artistById[album.artistId] || {}).name || '' }));

      tracks = store
        .findMany('track', { filter: (t) => t.title.toLowerCase().includes(q) })
        .sort((a, b) => b.plays - a.plays)
        .slice(0, 8);
    }

    const player = store.findMany('player')[0] || null;

    return {
      query,
      has,
      artists,
      albumRows,
      tracks,
      resultCount: artists.length + albumRows.length + tracks.length,
      currentTrackId: player ? player.currentTrackId : '',
      isPlaying: player ? player.isPlaying : false
    };
  }

  events = {
    // Manual bind: setData reflects the keystroke, refresh() re-runs data() so the
    // derived result lists recompute (setData alone does not re-run data(), SPEC §4).
    updateQuery: (event) => {
      this.setData('query', event.target.value);
      this.refresh();
    },
    // Escape clears the field and blurs it. `@keydown:escape` is a D38 key-filtered
    // binding (SPEC §5) — the handler only fires on the Escape key, no manual
    // event.key check. setData + refresh re-runs data() so the results reset.
    clearQuery: (event) => {
      this.setData('query', '');
      this.refresh();
      if (event.target) event.target.blur();
    },
    playTrack: (track) => {
      const player = this.ctx.store.findMany('player')[0] || null;
      const ids = this.getData().tracks.map((t) => t.id);
      if (player) player.play(track.id, ids);
    },
    likeTrack: (track) => track.toggleLike()
  };

  mounted() {
    const input = this.element.querySelector('input[type="text"]');
    if (input) input.focus();
  }

  animations = {
    in:  { from: { opacity: 0, transform: 'translateY(10px)' }, to: { opacity: 1, transform: 'translateY(0)' },  duration: 240, easing: 'ease-out' },
    out: { from: { opacity: 1, transform: 'translateY(0)' },    to: { opacity: 0, transform: 'translateY(-8px)' }, duration: 160, easing: 'ease-in' }
  };
}

import { ViewNode } from '@magic-spells/puzzle';

SearchView.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    new ViewNode('header', { class: 'mb-6' }, [
      new ViewNode('h1', { class: 'font-display text-3xl font-bold text-fg mb-4' }, [
        new ViewNode('text', { value: 'Search' }),
      ]),
      new ViewNode('input', {
        type: 'text',
        class: 'w-full max-w-xl h-12 px-4 rounded-xl bg-surface border border-hairline text-fg placeholder-faint focus:outline-none focus:border-accent/60 focus:ring-2 focus:ring-accent/20 transition-colors',
        placeholder: 'Artists, albums, songs…',
        value: __d.query,
        '@input': (event) => this.events.updateQuery(event),
        '@keydown:escape': (event) => this.events.clearQuery(event),
        autofocus: true,
      }, []),
    ]),
    ...(__d.has
      ? [
          ...(__d.resultCount > 0
            ? [
                ...(__d.artists.length > 0
                  ? [
                      new ViewNode('section', { class: 'mb-9' }, [
                        new ViewNode('h2', { class: 'font-display text-lg font-bold text-fg mb-4' }, [
                          new ViewNode('text', { value: 'Artists' }),
                        ]),
                        new ViewNode('div', {
                          class: 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6',
                        },
                          __d.artists.map((artist, i) =>
                            new ViewNode(ArtistCard, {
                              key: artist.id,
                              artist: artist,
                              index: i,
                            }, [])
                          )
                        ),
                      ]),
                    ]
                  : []),
                ...(__d.albumRows.length > 0
                  ? [
                      new ViewNode('section', { class: 'mb-9' }, [
                        new ViewNode('h2', { class: 'font-display text-lg font-bold text-fg mb-4' }, [
                          new ViewNode('text', { value: 'Albums' }),
                        ]),
                        new ViewNode('div', {
                          class: 'grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6',
                        },
                          __d.albumRows.map((row, i) =>
                            new ViewNode(AlbumCard, {
                              key: row.id,
                              album: row.album,
                              artistName: row.artistName,
                              index: i,
                            }, [])
                          )
                        ),
                      ]),
                    ]
                  : []),
                ...(__d.tracks.length > 0
                  ? [
                      new ViewNode('section', {}, [
                        new ViewNode('h2', { class: 'font-display text-lg font-bold text-fg mb-3' }, [
                          new ViewNode('text', { value: 'Songs' }),
                        ]),
                        new ViewNode('div', { class: 'flex flex-col' },
                          __d.tracks.map((track, i) =>
                            new ViewNode(TrackRow, {
                              key: track.id,
                              track: track,
                              position: i + 1,
                              current: track.id === __d.currentTrackId,
                              playing: track.id === __d.currentTrackId && __d.isPlaying,
                              play: (event) => this.events.playTrack(track),
                              like: (event) => this.events.likeTrack(track),
                            }, [])
                          )
                        ),
                      ]),
                    ]
                  : []),
              ]
            : [
                new ViewNode('div', { class: 'py-20 text-center text-muted' }, [
                  new ViewNode('text', { value: 'No results for “' + String(__d.query) + '”.' }),
                ]),
              ]),
        ]
      : [
          new ViewNode('div', { class: 'py-20 text-center text-muted' }, [
            new ViewNode('text', { value: 'Search your library by artist, album, or song.' }),
          ]),
        ]),
  ]);
};
