
import { PuzzleView } from '@magic-spells/puzzle';
import MiniPlayer from '../components/MiniPlayer.pzl';
import QueueDialog from '../components/QueueDialog.pzl';
import Toast from '../components/Toast.pzl';
import Icon from '../components/Icon.pzl';

export default class AppLayout extends PuzzleView {
  created() {
    this.setData({ queueOpen: false });
  }

  // data() re-runs on every navigation that reuses this layout (SPEC §9), so the
  // active-nav highlight recomputes from the current route without extra wiring.
  // We read this.route (v1.15, D47) — the per-navigation route snapshot — which
  // is correct inside the pre-commit gate AND in hash mode (D34), unlike
  // window.location.pathname (a fixed app path in hash mode) or router.current
  // (a navigation behind pre-commit). Routed layouts always receive this.route
  // (seeded via preload even on a fresh mount / return from PlayerLayout), so no
  // null guard is needed; we key the section off the TOP-LEVEL route name
  // (chain[0]), not the leaf: the artist route now nests children (D30), so its
  // leaf is 'artist-index' / 'artist-info' while the section it belongs to is
  // still 'artist'. chain[0].name is 'artist' for both — flat routes are a
  // one-element chain, so every other comparison is unchanged.
  data(params, props) {
    const name = this.route.chain[0].name;
    const section =
      name === 'library' ||
      name === 'artist' ||
      name === 'album' ||
      name === 'liked' ||
      name === 'playlist'
        ? 'library'
        : name === 'search'
          ? 'search'
          : '';
    // Sidebar "Library" links derived from the store (sorted by name) rather than
    // hardcoded, so the list tracks the seeded data.
    const artists = this.ctx.store
      .findMany('artist')
      .slice()
      .sort((a, b) => a.name.localeCompare(b.name));
    // Playlists from the store, sorted by their `order` field.
    const playlists = this.ctx.store
      .findMany('playlist')
      .slice()
      .sort((a, b) => a.order - b.order);
    return { queueOpen: this.getData().queueOpen, section, artists, playlists };
  }

  events = {
    toggleQueue: () => {
      this.setData('queueOpen', !this.getData().queueOpen);
      this.refresh();
    },
    closeQueue: () => {
      this.setData('queueOpen', false);
      this.refresh();
    },
    // Create a fresh empty playlist and navigate to it — the user lands on the
    // new page and renames it inline. createRecord notifies subscribers, so the
    // sidebar list above updates immediately.
    newPlaylist: () => {
      const store = this.ctx.store;
      const orders = store.findMany('playlist').map((p) => p.order);
      const nextOrder = orders.length ? Math.max(...orders) + 1 : 0;
      const id = 'pl-' + Date.now().toString(36);
      store.createRecord('playlist', {
        id,
        name: 'My Playlist',
        trackIds: [],
        accent: { from: '#7c5cff', to: '#a855f7' },
        order: nextOrder,
      });
      this.ctx.router.push('/playlist/' + id); // path-shaped (hash mode encodes it)
    },
  };

  // Window-level keyboard shortcuts. Unlike the per-element @event:modifier
  // bindings (D38), these must work regardless of what's focused — a GLOBAL
  // concern — so they live as a document listener on the persistent layout,
  // added in mounted() and torn down in destroyed(). Space toggles play/pause
  // (preventDefault so the page doesn't scroll), ←/→ skip. Ignored while typing
  // (input/textarea/select/contenteditable) and when a modifier is held (so
  // browser shortcuts like ⌘← keep working).
  _onKeydown = (event) => {
    const t = event.target;
    const tag = t && t.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (t && t.isContentEditable)) return;
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const player = this.ctx.store.findMany('player')[0];
    if (!player) return;
    if (event.key === ' ' || event.key === 'Spacebar') {
      event.preventDefault();
      player.toggle();
    } else if (event.key === 'ArrowLeft') {
      player.prev();
    } else if (event.key === 'ArrowRight') {
      player.next();
    }
  };

  mounted() {
    document.addEventListener('keydown', this._onKeydown);
  }

  destroyed() {
    document.removeEventListener('keydown', this._onKeydown);
  }

  // Plays only on a LAYOUT swap (to/from PlayerLayout), not on view-only swaps
  // within this layout (constellation/doc/DOC-SPEC.md §12).
  animations = {
    in:  { from: { opacity: 0, transform: 'scale(0.98)' }, to: { opacity: 1, transform: 'scale(1)' },    duration: 280, easing: 'ease-out' },
    out: { from: { opacity: 1, transform: 'scale(1)' },    to: { opacity: 0, transform: 'scale(0.99)' }, duration: 180, easing: 'ease-in' }
  };
}

import { ViewNode, SLOT_TAG } from '@magic-spells/puzzle';

AppLayout.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', { class: 'h-screen flex flex-col bg-bg text-fg overflow-hidden' }, [
    new ViewNode('div', { class: 'flex-1 flex min-h-0' }, [
      new ViewNode('aside', { class: 'hidden sm:flex w-60 shrink-0 flex-col bg-surface border-r border-line p-3' }, [
        new ViewNode('a', {
          href: '#/',
          class: 'flex items-center gap-2.5 px-3 py-3 mb-4 font-display text-lg font-bold text-fg hover:no-underline',
        }, [
          new ViewNode('span', {
            class: 'inline-block w-7 h-7 rounded-lg',
            style: 'background:linear-gradient(135deg,#7c5cff,#22d3ee)',
          }, []),
          new ViewNode('text', { value: 'Puzzle Sounds' }),
        ]),
        new ViewNode('a', {
          href: '#/',
          class: `flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors hover:no-underline hover:text-fg ${__d.section === 'library' ? 'text-fg bg-surface-2' : 'text-muted'}`,
        }, [
          new ViewNode(Icon, {
            name: 'home',
            size: 18,
          }, []),
          new ViewNode('text', { value: ' Home' }),
        ]),
        new ViewNode('a', {
          href: '#/search',
          class: `flex items-center gap-3 px-3 py-2.5 rounded-lg font-medium transition-colors hover:no-underline hover:text-fg ${__d.section === 'search' ? 'text-fg bg-surface-2' : 'text-muted'}`,
        }, [
          new ViewNode(Icon, {
            name: 'search',
            size: 18,
          }, []),
          new ViewNode('text', { value: ' Search' }),
        ]),
        new ViewNode('div', {
          class: 'mt-6 px-3 pb-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-faint',
        }, [
          new ViewNode('text', { value: 'Library' }),
        ]),
        ...__d.artists.map((artist, i) =>
          new ViewNode('a', {
            key: artist.id,
            href: `#/artist/${artist.id}`,
            class: 'px-3 py-2 rounded-lg text-sm text-muted hover:text-fg hover:no-underline hover:bg-surface-2 transition-colors',
          }, [
            new ViewNode('text', { value: String(artist.name) }),
          ])
        ),
        new ViewNode('div', {
          class: 'mt-6 px-3 pb-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-faint',
        }, [
          new ViewNode('text', { value: 'Playlists' }),
        ]),
        new ViewNode('a', {
          href: '#/liked',
          class: 'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted hover:text-fg hover:no-underline hover:bg-surface-2 transition-colors',
        }, [
          new ViewNode('span', {
            class: 'inline-flex items-center justify-center w-6 h-6 rounded shrink-0 text-white/90',
            style: 'background:linear-gradient(135deg,#7c5cff,#c86dd7)',
          }, [
            new ViewNode(Icon, {
              name: 'heart-filled',
              size: 12,
            }, []),
          ]),
          new ViewNode('text', { value: 'Liked Songs' }),
        ]),
        ...__d.playlists.map((p, i) =>
          new ViewNode('a', {
            key: p.id,
            href: `#/playlist/${p.id}`,
            class: 'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted hover:text-fg hover:no-underline hover:bg-surface-2 transition-colors',
          }, [
            new ViewNode('span', {
              class: 'inline-block w-6 h-6 rounded shrink-0',
              style: `background:${p.artwork}`,
            }, []),
            new ViewNode('span', { class: 'truncate' }, [
              new ViewNode('text', { value: String(p.name) }),
            ]),
          ])
        ),
        new ViewNode('button', {
          '@click': (event) => this.events.newPlaylist(event),
          class: 'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-muted hover:text-fg hover:bg-surface-2 transition-colors text-left w-full',
        }, [
          new ViewNode('span', {
            class: 'inline-flex items-center justify-center w-6 h-6 rounded shrink-0 border border-hairline',
          }, [
            new ViewNode(Icon, {
              name: 'plus',
              size: 14,
            }, []),
          ]),
          new ViewNode('text', { value: 'New playlist' }),
        ]),
      ]),
      new ViewNode('main', { class: 'flex-1 min-h-0 overflow-y-auto relative isolate' }, [
        new ViewNode('div', { class: 'max-w-5xl mx-auto px-5 sm:px-8 py-8' }, [
          new ViewNode(SLOT_TAG),
        ]),
      ]),
    ]),
    new ViewNode(MiniPlayer, { toggleQueue: (event) => this.events.toggleQueue(event) }, []),
    new ViewNode('nav', { class: 'sm:hidden shrink-0 flex border-t border-line bg-surface' }, [
      new ViewNode('a', {
        href: '#/',
        class: `flex-1 flex flex-col items-center gap-0.5 py-2.5 text-[11px] font-medium transition-colors hover:no-underline ${__d.section === 'library' ? 'text-fg' : 'text-muted'}`,
      }, [
        new ViewNode(Icon, {
          name: 'home',
          size: 22,
        }, []),
        new ViewNode('text', { value: 'Home' }),
      ]),
      new ViewNode('a', {
        href: '#/search',
        class: `flex-1 flex flex-col items-center gap-0.5 py-2.5 text-[11px] font-medium transition-colors hover:no-underline ${__d.section === 'search' ? 'text-fg' : 'text-muted'}`,
      }, [
        new ViewNode(Icon, {
          name: 'search',
          size: 22,
        }, []),
        new ViewNode('text', { value: 'Search' }),
      ]),
    ]),
    new ViewNode(QueueDialog, {
      open: __d.queueOpen,
      close: (event) => this.events.closeQueue(event),
    }, []),
    new ViewNode(Toast, {}, []),
  ]);
};
