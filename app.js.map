
import { PuzzleView } from '@magic-spells/puzzle';
import { captureArtMorph } from '../art-morph.js';

export default class ArtistCard extends PuzzleView {
  data(params, props) {
    return { artist: props.artist };
  }

  events = {
    // Capture-at-click artist-avatar flight (app/art-morph.js) — same pattern as
    // AlbumCard: snapshot the circle's rect into a fixed clone, let the anchor
    // navigate, and the clone springs into the artist page's header avatar.
    // Both ends are rounded-full, so the blob stays a circle the whole flight.
    cardClick: () => {
      const artist = this.getData().artist;
      if (!artist) return;
      captureArtMorph(this.element.querySelector('[data-art-morph]'), 'artist-' + artist.id);
    }
  };

  // Per-instance staggered enter: the parent threads each card's position in as
  // `index` (via the {#for … , i} counter), and that becomes the animation delay
  // so the grid cascades in. A getter, not a static field, because the delay is
  // read per instance at mount (constellation/doc/DOC-SPEC.md §12).
  get animations() {
    const index = this.props.index ?? 0;
    return {
      in: {
        from: { opacity: 0, transform: 'translateY(14px)' },
        to:   { opacity: 1, transform: 'translateY(0)' },
        duration: 320,
        delay: index * 55,
        easing: 'ease-out'
      }
    };
  }
}

import { ViewNode } from '@magic-spells/puzzle';

ArtistCard.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('a', {
    href: `#/artist/${__d.artist.id}`,
    class: 'group block text-center hover:no-underline',
    '@click': (event) => this.events.cardClick(event),
  }, [
    new ViewNode('div', {
      'data-art-morph': `artist-${__d.artist.id}`,
      class: 'aspect-square rounded-full mb-3 flex items-center justify-center shadow-lg shadow-black/40 ring-1 ring-white/10 transition-transform duration-200 group-hover:scale-[1.04]',
      style: `background:${__d.artist.artwork}`,
    }, [
      new ViewNode('span', { class: 'font-display text-2xl font-bold text-white/90 drop-shadow' }, [
        new ViewNode('text', { value: String(__d.artist.initials) }),
      ]),
    ]),
    new ViewNode('div', { class: 'font-semibold text-fg truncate' }, [
      new ViewNode('text', { value: String(__d.artist.name) }),
    ]),
    new ViewNode('div', { class: 'text-xs text-muted mt-0.5' }, [
      new ViewNode('text', { value: String(__d.artist.genre) }),
    ]),
  ]);
};
