
import { PuzzleView } from '@magic-spells/puzzle';

// A tiny "now playing" visualizer. `playing` (bool prop) gates the animation.
export default class EqualizerBars extends PuzzleView {
  data(params, props) {
    return { playing: !!props.playing };
  }
}

import { ViewNode } from '@magic-spells/puzzle';

EqualizerBars.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('div', { class: 'flex items-end gap-[3px] h-3.5 leading-none' },
    Array.from({ length: 5 - 1 + 1 }, (_, __i) => 1 + __i).map((i) =>
      new ViewNode('span', {
        key: i,
        class: `eq-bar w-[3px] h-full rounded-full bg-current ${__d.playing ? 'eq-bar--on' : ''}`,
        style: `animation-delay:${i * 110}ms`,
      }, [])
    )
  );
};
