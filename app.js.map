
import { PuzzleView } from '@magic-spells/puzzle';
import { captureArtMorph } from '../art-morph.js';
import Icon from './Icon.pzl';

export default class AlbumCard extends PuzzleView {
  data(params, props) {
    return {
      album: props.album,
      artistName: props.artistName || ''
    };
  }

  events = {
    // Capture-at-click album-art flight (app/art-morph.js). NON-preventing: we snapshot
    // the card artwork's rect into a fixed clone, then let the anchor navigate normally.
    // When the Album view's header artwork appears, the clone springs into it — bridging
    // the sibling-view swap that the router morph (D55) can't (source view dies first).
    // The hover play button's @click:prevent:stop means it never reaches this handler.
    cardClick: () => {
      const album = this.getData().album;
      if (!album) return;
      captureArtMorph(this.element.querySelector('[data-art-morph]'), 'album-' + album.id);
    },
    // Play the album's tracks in trackNo order, first track cued. Navigation is
    // suppressed by the @click:prevent:stop modifiers on the button (D38), so
    // this only starts playback — the card's <a> never fires.
    playAlbum: () => {
      const store = this.ctx.store;
      const album = this.getData().album;
      if (!album) return;
      const ids = store
        .findMany('track', { filter: (t) => t.albumId === album.id })
        .sort((a, b) => a.trackNo - b.trackNo)
        .map((t) => t.id);
      const player = store.findMany('player')[0] || null;
      if (player && ids.length) player.play(ids[0], ids);
    }
  };

  get animations() {
    const index = this.props.index ?? 0;
    return {
      in: {
        from: { opacity: 0, transform: 'translateY(16px)' },
        to:   { opacity: 1, transform: 'translateY(0)' },
        duration: 320,
        delay: index * 55,
        easing: 'ease-out'
      }
    };
  }
}

import { ViewNode } from '@magic-spells/puzzle';

AlbumCard.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('a', {
    href: `#/album/${__d.album.id}`,
    class: 'group block hover:no-underline',
    '@click': (event) => this.events.cardClick(event),
  }, [
    new ViewNode('div', {
      'data-art-morph': `album-${__d.album.id}`,
      class: 'aspect-square rounded-xl mb-3 relative overflow-hidden shadow-lg shadow-black/40 ring-1 ring-white/10 transition-transform duration-200 group-hover:scale-[1.02]',
      style: `background:${__d.album.artwork}`,
    }, [
      new ViewNode('div', {
        class: 'absolute inset-0 flex items-end p-3 bg-gradient-to-t from-black/35 to-transparent',
      }, [
        new ViewNode('span', { class: 'font-display text-lg font-bold text-white leading-tight drop-shadow' }, [
          new ViewNode('text', { value: String(__d.album.title) }),
        ]),
      ]),
      new ViewNode('button', {
        type: 'button',
        class: 'absolute bottom-3 right-3 w-11 h-11 rounded-full bg-accent text-accent-ink shadow-xl flex items-center justify-center opacity-0 translate-y-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-y-0 focus-visible:opacity-100 focus-visible:translate-y-0',
        'aria-label': `Play ${__d.album.title}`,
        '@click:prevent:stop': (event) => this.events.playAlbum(event),
      }, [
        new ViewNode('span', { class: 'translate-x-px flex' }, [
          new ViewNode(Icon, {
            name: 'play',
            size: 18,
          }, []),
        ]),
      ]),
    ]),
    new ViewNode('div', { class: 'text-sm font-semibold text-fg truncate' }, [
      new ViewNode('text', { value: String(__d.album.title) }),
    ]),
    new ViewNode('div', { class: 'text-xs text-muted mt-0.5 truncate' }, [
      new ViewNode('text', { value: String(__d.album.year) + ' · ' + String(__d.artistName) }),
    ]),
  ]);
};
