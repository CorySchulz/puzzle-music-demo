
import { PuzzleView } from '@magic-spells/puzzle';
import EqualizerBars from '../components/EqualizerBars.pzl';
import Icon from '../components/Icon.pzl';

// Full-screen player. No `animations` field: it rides PlayerLayout's swap
// (one animator per transition, SPEC §12). It owns the playback tick while
// visible — started in viewDidShow(), stopped in viewWillHide() — which is why
// those lifecycle hooks exist. The MiniPlayer owns the tick everywhere else;
// only one is ever mounted, so the clock never double-counts.
export default class NowPlayingView extends PuzzleView {
  data(params, props) {
    const store = this.ctx.store;
    const player = store.findMany('player')[0] || null;
    const track = player && player.currentTrackId ? store.findOne('track', player.currentTrackId) : null;
    const album = track ? store.findOne('album', track.albumId) : null;
    const artist = track ? store.findOne('artist', track.artistId) : null;
    const progressSec = player ? player.progressSec : 0;
    const durationSec = track ? track.durationSec : 0;
    return {
      track,
      artwork: album ? album.artwork : 'linear-gradient(135deg,#3a3a44,#22222a)',
      // Header glow color: current album's accent.from + '4d' (≈ 30% alpha).
      headerGlow: album && album.accent ? (album.accent.from || '#3a3a44') + '4d' : '',
      artistName: artist ? artist.name : '',
      isPlaying: player ? player.isPlaying : false,
      volume: player ? player.volume : 0.8,
      shuffle: player ? player.shuffle : false,
      repeat: player ? player.repeat : 'off',
      progressSec,
      durationSec,
      progressPct: durationSec ? Math.min(100, (progressSec / durationSec) * 100) : 0
    };
  }

  events = {
    toggle: () => { this._player()?.toggle(); },
    next:   () => { this._player()?.next(); },
    prev:   () => { this._player()?.prev(); },
    toggleShuffle: () => { this._player()?.toggleShuffle(); },
    cycleRepeat:   () => { this._player()?.cycleRepeat(); },
    toggleMute:    () => { this._player()?.toggleMute(); },
    // Range input hands us a string in event.target.value; the model clamps it.
    setVolume: (event) => { this._player()?.setVolume(event.target.value); },
    like:   () => {
      const t = this.getData().track;
      if (t) t.toggleLike();
    },
    seek: (event) => {
      const player = this._player();
      const { durationSec } = this.getData();
      if (!player || !durationSec) return;
      const rect = event.currentTarget.getBoundingClientRect();
      const pct = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
      player.seekTo(pct * durationSec);
    }
  };

  _player() {
    return this.ctx.store.findMany('player')[0] || null;
  }

  // Lifecycle hooks (v1.1): own the tick only while this view is on screen.
  viewDidShow() {
    this._timer = setInterval(() => this._tick(), 1000);
  }

  viewWillHide() {
    this._stopTick();
  }

  destroyed() {
    this._stopTick();
  }

  _stopTick() {
    if (this._timer) clearInterval(this._timer);
    this._timer = null;
  }

  _tick() {
    const player = this._player();
    if (!player || !player.isPlaying || !player.currentTrackId) return;
    const track = this.ctx.store.findOne('track', player.currentTrackId);
    if (!track) return;
    if (player.progressSec + 1 >= track.durationSec) {
      player.advance(); // auto-advance: repeat/shuffle rules live in the model
    } else {
      player.update({ progressSec: player.progressSec + 1 });
    }
  }
}

import { ViewNode } from '@magic-spells/puzzle';

NowPlayingView.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', { class: 'h-full flex flex-col items-center justify-center px-6 pb-10' }, [
    ...(__d.track
      ? [
          new ViewNode('div', {
            class: 'pointer-events-none absolute inset-x-0 top-0 -z-10 h-80',
            style: `background:linear-gradient(to bottom, ${__d.headerGlow}, transparent)`,
          }, []),
          new ViewNode('div', { class: 'w-full max-w-md flex flex-col items-center' }, [
            new ViewNode('div', {
              class: 'w-full aspect-square rounded-3xl mb-8 ring-1 ring-white/10 shadow-2xl shadow-black/60',
              style: `background:${__d.artwork}`,
            }, []),
            new ViewNode('div', { class: 'w-full flex items-start justify-between gap-4 mb-6' }, [
              new ViewNode('div', { class: 'min-w-0' }, [
                new ViewNode('h1', { class: 'font-display text-2xl font-bold text-fg truncate' }, [
                  new ViewNode('text', { value: String(__d.track.title) }),
                ]),
                new ViewNode('a', {
                  href: `#/artist/${__d.track.artistId}`,
                  class: 'text-muted hover:text-fg hover:no-underline',
                }, [
                  new ViewNode('text', { value: String(__d.artistName) }),
                ]),
              ]),
              new ViewNode('button', {
                class: `shrink-0 transition-colors ${__d.track.liked ? 'text-accent' : 'text-faint hover:text-fg'}`,
                title: 'Like',
                'aria-label': 'Like',
                '@click': (event) => this.events.like(event),
              }, [
                ...(__d.track.liked
                  ? [
                      new ViewNode(Icon, {
                        name: 'heart-filled',
                        size: 22,
                      }, []),
                    ]
                  : [
                      new ViewNode(Icon, {
                        name: 'heart',
                        size: 22,
                      }, []),
                    ]),
              ]),
            ]),
            new ViewNode('div', { class: 'w-full' }, [
              new ViewNode('div', {
                class: 'h-1.5 rounded-full bg-elevated overflow-hidden cursor-pointer',
                title: 'Seek',
                '@click': (event) => this.events.seek(event),
              }, [
                new ViewNode('div', {
                  class: 'h-full rounded-full bg-accent',
                  style: `width:${__d.progressPct}%`,
                }, []),
              ]),
              new ViewNode('div', { class: 'flex justify-between mt-1.5 text-[11px] tabular-nums text-faint' }, [
                new ViewNode('span', {}, [
                  new ViewNode('text', { value: String((__f.duration || __f.__missing('duration'))(__d.progressSec)) }),
                ]),
                new ViewNode('span', {}, [
                  new ViewNode('text', { value: String((__f.duration || __f.__missing('duration'))(__d.durationSec)) }),
                ]),
              ]),
            ]),
            new ViewNode('div', { class: 'flex items-center gap-6 mt-8' }, [
              new ViewNode('button', {
                class: `transition-colors ${__d.shuffle ? 'text-accent hover:text-accent-2' : 'text-muted hover:text-fg'}`,
                title: 'Shuffle',
                'aria-label': 'Shuffle',
                '@click': (event) => this.events.toggleShuffle(event),
              }, [
                new ViewNode(Icon, {
                  name: 'shuffle',
                  size: 18,
                }, []),
              ]),
              new ViewNode('button', {
                class: 'text-muted hover:text-fg transition-colors',
                title: 'Previous',
                'aria-label': 'Previous',
                '@click': (event) => this.events.prev(event),
              }, [
                new ViewNode(Icon, {
                  name: 'prev',
                  size: 22,
                }, []),
              ]),
              new ViewNode('button', {
                class: 'w-16 h-16 rounded-full bg-fg text-bg flex items-center justify-center hover:scale-105 active:scale-95 transition-transform',
                title: 'Play / pause',
                'aria-label': 'Play / pause',
                '@click': (event) => this.events.toggle(event),
              }, [
                ...(__d.isPlaying
                  ? [
                      new ViewNode(Icon, {
                        name: 'pause',
                        size: 24,
                      }, []),
                    ]
                  : [
                      new ViewNode('span', { class: 'translate-x-0.5 flex' }, [
                        new ViewNode(Icon, {
                          name: 'play',
                          size: 24,
                        }, []),
                      ]),
                    ]),
              ]),
              new ViewNode('button', {
                class: 'text-muted hover:text-fg transition-colors',
                title: 'Next',
                'aria-label': 'Next',
                '@click': (event) => this.events.next(event),
              }, [
                new ViewNode(Icon, {
                  name: 'next',
                  size: 22,
                }, []),
              ]),
              new ViewNode('button', {
                class: `transition-colors ${__d.repeat !== 'off' ? 'text-accent hover:text-accent-2' : 'text-muted hover:text-fg'}`,
                title: 'Repeat',
                'aria-label': 'Repeat',
                '@click': (event) => this.events.cycleRepeat(event),
              }, [
                ...(((__c) =>
                  __c === ('one')
                    ? [
                        new ViewNode(Icon, {
                          name: 'repeat-one',
                          size: 18,
                        }, []),
                      ]
                    : [
                        new ViewNode(Icon, {
                          name: 'repeat',
                          size: 18,
                        }, []),
                      ])(__d.repeat)),
              ]),
            ]),
            new ViewNode('div', { class: 'w-full max-w-[240px] mx-auto flex items-center gap-3 mt-6' }, [
              new ViewNode('button', {
                class: 'shrink-0 text-muted hover:text-fg transition-colors',
                title: 'Mute',
                'aria-label': 'Mute',
                '@click': (event) => this.events.toggleMute(event),
              }, [
                ...(__d.volume === 0
                  ? [
                      new ViewNode(Icon, {
                        name: 'volume-mute',
                        size: 18,
                      }, []),
                    ]
                  : [
                      new ViewNode(Icon, {
                        name: 'volume',
                        size: 18,
                      }, []),
                    ]),
              ]),
              new ViewNode('input', {
                type: 'range',
                min: '0',
                max: '1',
                step: '0.01',
                class: 'flex-1',
                title: 'Volume',
                'aria-label': 'Volume',
                value: __d.volume,
                '@input': (event) => this.events.setVolume(event),
              }, []),
            ]),
            new ViewNode('div', { class: 'mt-9 text-accent' }, [
              new ViewNode(EqualizerBars, { playing: __d.isPlaying }, []),
            ]),
          ]),
        ]
      : [
          new ViewNode('div', { class: 'text-center text-muted' }, [
            new ViewNode('p', { class: 'mb-4' }, [
              new ViewNode('text', { value: 'Nothing is playing right now.' }),
            ]),
            new ViewNode('a', {
              href: '#/',
              class: 'text-accent hover:no-underline',
            }, [
              new ViewNode('text', { value: 'Go find something ♪' }),
            ]),
          ]),
        ]),
  ]);
};
