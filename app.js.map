
import { PuzzleView } from '@magic-spells/puzzle';

// Reusable button (component mode renders inline — no wrapper, single root, D20).
// Label content projects through <Slot/>; `press` is a callback prop (D16).
export default class Button extends PuzzleView {
  data(params, props) {
    return {
      variant: props.variant || 'primary',
      type: props.type || 'button',
      disabled: props.disabled || false
    };
  }

  events = {
    handleClick: (event) => {
      if (this.getData().disabled) return;
      const { press } = this.props;
      if (typeof press === 'function') press(event);
    }
  };
}

import { ViewNode, SLOT_TAG } from '@magic-spells/puzzle';

Button.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('button', {
    class: `inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold cursor-pointer transition-all disabled:opacity-50 disabled:cursor-not-allowed ${__d.variant === 'ghost' ? 'bg-transparent text-fg border border-hairline hover:border-fg/40' : ''}${__d.variant === 'primary' ? 'bg-accent text-accent-ink hover:bg-accent-2 hover:scale-[1.03] active:scale-95' : ''}`,
    type: __d.type,
    disabled: __d.disabled,
    '@click': (event) => this.events.handleClick(event),
  }, [
    new ViewNode(SLOT_TAG),
  ]);
};
