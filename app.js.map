
import { PuzzleView } from '@magic-spells/puzzle';
import { seedReady } from '../app.js';
import Button from '../components/Button.pzl';
import TrackRow from '../components/TrackRow.pzl';
import Icon from '../components/Icon.pzl';

export default class AlbumView extends PuzzleView {
  // Async data() gated on seedReady (SPEC §16, D39): the <puzzle-skeleton> shows
  // while this awaits, then the real album patches in. Post-seedReady a missing
  // album is a genuine not-found.
  async data(params, props) {
    await seedReady;
    const store = this.ctx.store;
    const album = store.findOne('album', params.id);
    const artist = album ? store.findOne('artist', album.artistId) : null;
    const tracks = store
      .findMany('track', { filter: (t) => t.albumId === params.id })
      .sort((a, b) => a.trackNo - b.trackNo);
    const totalSec = tracks.reduce((sum, t) => sum + (t.durationSec || 0), 0);
    const player = store.findMany('player')[0] || null;

    return {
      album,
      artist,
      tracks,
      // Header glow color: accent.from + '4d' (8-digit hex ≈ 30% alpha). Computed
      // here, not in the template (logic stays out of the markup).
      headerGlow: album && album.accent ? (album.accent.from || '#3a3a44') + '4d' : '',
      trackIds: tracks.map((t) => t.id),
      totalMin: Math.max(1, Math.round(totalSec / 60)),
      currentTrackId: player ? player.currentTrackId : '',
      isPlaying: player ? player.isPlaying : false
    };
  }

  events = {
    playAlbum: () => {
      const player = this._player();
      const ids = this.getData().trackIds;
      if (player && ids.length) player.play(ids[0], ids);
    },
    playTrack: (track) => {
      const player = this._player();
      if (player) player.play(track.id, this.getData().trackIds);
    },
    likeTrack: (track) => track.toggleLike()
  };

  _player() {
    return this.ctx.store.findMany('player')[0] || null;
  }

  animations = {
    // in is OPACITY-ONLY (no translateY): the art-morph engine measures the header
    // artwork's rect once at flight start, so a transform-based entrance would slide the
    // real artwork away from where the blob lands (~10px pop at the skeleton→real reveal).
    in:  { from: { opacity: 0 }, to: { opacity: 1 }, duration: 260, easing: 'ease-out' },
    out: { from: { opacity: 1, transform: 'translateY(0)' },    to: { opacity: 0, transform: 'translateY(-8px)' }, duration: 160, easing: 'ease-in' }
  };
}

import { ViewNode } from '@magic-spells/puzzle';

AlbumView.prototype.render = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    ...(__d.album
      ? [
          new ViewNode('div', {
            class: 'pointer-events-none absolute inset-x-0 top-0 -z-10 h-80',
            style: `background:linear-gradient(to bottom, ${__d.headerGlow}, transparent)`,
          }, []),
          new ViewNode('header', { class: 'mb-8' }, [
            new ViewNode('div', { class: 'flex flex-col sm:flex-row items-center sm:items-end gap-6' }, [
              new ViewNode('div', {
                'data-art-morph': `album-${__d.album.id}`,
                class: 'w-44 h-44 sm:w-52 sm:h-52 rounded-2xl shrink-0 ring-1 ring-white/10 shadow-2xl shadow-black/50',
                style: `background:${__d.album.artwork}`,
              }, []),
              new ViewNode('div', { class: 'text-center sm:text-left min-w-0 pb-1' }, [
                new ViewNode('div', {
                  class: 'text-[11px] font-semibold uppercase tracking-[0.18em] text-muted mb-2',
                }, [
                  new ViewNode('text', { value: 'Album · ' + String(__d.album.era) }),
                ]),
                new ViewNode('h1', { class: 'font-display text-3xl sm:text-5xl font-bold text-fg leading-tight' }, [
                  new ViewNode('text', { value: String(__d.album.title) }),
                ]),
                new ViewNode('p', { class: 'text-muted mt-3' }, [
                  ...(__d.artist
                    ? [
                        new ViewNode('a', {
                          href: `#/artist/${__d.album.artistId}`,
                          class: 'text-fg font-semibold hover:text-accent hover:no-underline',
                        }, [
                          new ViewNode('text', { value: String(__d.artist.name) }),
                        ]),
                        new ViewNode('text', { value: ' · ' }),
                      ]
                    : []),
                  new ViewNode('text', { value: String(__d.album.year) + ' · ' + String(__d.tracks.length) + ' ' + String((__f.plural || __f.__missing('plural'))(__d.tracks.length, 'song', 'songs')) + ' · ' + String(__d.totalMin) + ' min' }),
                ]),
              ]),
            ]),
            new ViewNode('div', { class: 'flex items-center gap-3 mt-6 justify-center sm:justify-start' }, [
              new ViewNode(Button, { press: (event) => this.events.playAlbum(event) }, [
                new ViewNode(Icon, {
                  name: 'play',
                  size: 16,
                }, []),
                new ViewNode('text', { value: ' Play' }),
              ]),
            ]),
          ]),
          new ViewNode('section', { class: 'flex flex-col' },
            __d.tracks.map((track, i) =>
              new ViewNode(TrackRow, {
                key: track.id,
                track: track,
                position: track.trackNo,
                current: track.id === __d.currentTrackId,
                playing: track.id === __d.currentTrackId && __d.isPlaying,
                play: (event) => this.events.playTrack(track),
                like: (event) => this.events.likeTrack(track),
              }, [])
            )
          ),
        ]
      : [
          new ViewNode('div', { class: 'py-24 text-center' }, [
            new ViewNode('h1', { class: 'text-xl text-fg mb-2' }, [
              new ViewNode('text', { value: 'Album not found' }),
            ]),
            new ViewNode('p', { class: 'text-muted' }, [
              new ViewNode('text', { value: 'No album with that id. ' }),
              new ViewNode('a', {
                href: '#/',
                class: 'text-accent',
              }, [
                new ViewNode('text', { value: 'Back to your library' }),
              ]),
              new ViewNode('text', { value: '.' }),
            ]),
          ]),
        ]),
  ]);
};

AlbumView.prototype.renderSkeleton = function () {
  const __d = this.getData();
  const __f = this.ctx.formatters.getAll();

  return new ViewNode('puzzle-view', {}, [
    new ViewNode('div', { class: 'animate-pulse' }, [
      new ViewNode('header', { class: 'mb-8' }, [
        new ViewNode('div', { class: 'flex flex-col sm:flex-row items-center sm:items-end gap-6' }, [
          new ViewNode('div', { class: 'w-44 h-44 sm:w-52 sm:h-52 rounded-2xl shrink-0 bg-surface-2' }, []),
          new ViewNode('div', { class: 'min-w-0 pb-1 flex-1' }, [
            new ViewNode('div', { class: 'h-3 w-24 rounded bg-surface-2 mb-3' }, []),
            new ViewNode('div', { class: 'h-10 w-72 max-w-full rounded-lg bg-elevated mb-3' }, []),
            new ViewNode('div', { class: 'h-3 w-48 rounded bg-surface-2' }, []),
          ]),
        ]),
      ]),
      new ViewNode('div', { class: 'flex flex-col gap-2' },
        Array.from({ length: 4 - 1 + 1 }, (_, __i) =>
          new ViewNode('div', {
            key: __i,
            class: 'h-12 rounded-lg bg-surface-2',
          }, [])
        )
      ),
    ]),
  ]);
};
